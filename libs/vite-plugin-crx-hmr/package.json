{
  "name": "@bgafe/vite-plugin-crx-hmr",
  "description": "用于开发 Chromium manifest v3 插件的 Vite 插件，主要提供热重载功能，快速更新，高效开发",
  "private": false,
  "version": "2.0.0",
  "type": "module",
  "keywords": [
    "crx",
    "Chromium",
    "Chrome",
    "Edge",
    "extensions",
    "hmr",
    "manifest v3",
    "热更新"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --watch --config-loader tsx",
    "build": "tsdown --config-loader tsx",
    "type-check": "tsc --noEmit",
    "release": "pnpm type-check && pnpm build && pnpm publish --no-git-checks"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "vite": "^8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingoogolapple/bga-vite-plugin-crx-hmr.git",
    "directory": "libs/vite-plugin-crx-hmr"
  },
  "homepage": "https://github.com/bingoogolapple/bga-vite-plugin-crx-hmr#readme",
  "bugs": {
    "url": "https://github.com/bingoogolapple/bga-vite-plugin-crx-hmr/issues"
  },
  "author": "bingoogolapple <bingoogolapple@gmail.com>",
  "license": "MIT"
}
